# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
POSTGRES_USER=inquira_user
POSTGRES_PASSWORD=inquira_pass
POSTGRES_DB=inquira_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inquira_user:inquira_pass@localhost:5432/inquira_db
DATABASE_URL_SYNC=postgresql://inquira_user:inquira_pass@localhost:5432/inquira_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=inquira_chunks

# Security & JWT Auth
JWT_SECRET_KEY=supersecretjwtkeychangeinproduction1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & Embedding Settings
OPENAI_API_KEY=your-openai-api-key-here
DENSE_EMBEDDING_MODEL=text-embedding-3-small
DENSE_EMBEDDING_DIM=1536
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gpt-4o-mini
FAST_LLM_MODEL=gpt-4o-mini

# Document Ingestion Settings
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Rate Limiting & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=60
