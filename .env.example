# ==============================
# Application
# ==============================

APP_NAME=Inquira
ENVIRONMENT=development


# ==============================
# Security
# ==============================

SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==============================
# PostgreSQL
# ==============================

POSTGRES_USER=inquira
POSTGRES_PASSWORD=inquira_password
POSTGRES_DB=inquira
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://inquira:inquira_password@postgres:5432/inquira


# ==============================
# Redis
# ==============================

REDIS_URL=redis://redis:6379/0


# ==============================
# Qdrant
# ==============================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=inquira


# ==============================
# AI
# ==============================

OPENAI_API_KEY=

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small


# ==============================
# Frontend
# ==============================

FRONTEND_URL=http://localhost:3000
